# Copy to .env next to docker-compose.yml, then `docker compose up -d --build`.

# --- Required ---
JWT_SECRET=doi-thanh-mot-chuoi-ngau-nhien-dai

# --- Matterport (build-time: rebuild `web` after changing) ---
# Space id = the `m=` value in a Matterport showcase URL.
VITE_MATTERPORT_MODEL_SID=
# Needs Developer Tools / SDK Key on the Matterport plan.
VITE_MATTERPORT_SDK_KEY=

# --- Ports (change only on collision) ---
API_PORT=3000
WEB_PORT=8080
DB_PORT_HOST=5433

# Must match API_PORT — the browser calls this, not the compose network.
VITE_SHOWROOM_API_BASE=http://localhost:3000

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db

# --- Optional ---
JWT_EXPIRES_IN=7d
SHOWROOM_DB_POOL_MAX=5
