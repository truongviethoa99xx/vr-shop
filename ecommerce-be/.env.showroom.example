# Showroom 3D — backend env additions. Append to Ecommerce-BE/.env
# The showroom reuses the existing DB_* vars; nothing here is required to boot.

# Run the showroom migration automatically on startup.
# Prefer the explicit CLI run in production (see INTEGRATION.md §2).
SHOWROOM_RUN_MIGRATIONS=false

# Max connections for the module's own pool (it uses a named DataSource).
SHOWROOM_DB_POOL_MAX=5

# Placeholder QR details used only by StubPaymentProvider while payment is
# deferred. These are NOT chargeable and contact no gateway.
# 970436 = Vietcombank BIN.
SHOWROOM_STUB_BANK_BIN=970436
SHOWROOM_STUB_BANK_ACCOUNT=0000000000
