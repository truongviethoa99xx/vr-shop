# Showroom 3D — frontend env additions. Append to Ecommerce-UI/.env
# Vite only exposes VITE_-prefixed vars to the browser; NEXT_PUBLIC_* would
# read as undefined here. Do not commit real values.

# Matterport space id (the `m=` value in a showcase URL).
VITE_MATTERPORT_MODEL_SID=

# Matterport SDK key. Requires Developer Tools on the Matterport plan.
# This ships to the browser by design — scope it to your domains in the
# Matterport dashboard.
VITE_MATTERPORT_SDK_KEY=

# Backend origin. The rest of the app hardcodes http://localhost:3000.
VITE_SHOWROOM_API_BASE=http://localhost:3000

# Optional overrides.
# Pin a specific hosted SDK version instead of `latest`:
# VITE_MATTERPORT_SDK_SRC=https://static.matterport.com/showcase-sdk/latest.js
# Or point at a self-hosted SDK Bundle (expects <path>/showcase.html):
# VITE_MATTERPORT_BUNDLE_PATH=/matterport-bundle
